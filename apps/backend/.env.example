# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# URL Shortener Base
SHORT_URL_BASE=http://localhost:3000

# Node Environment
NODE_ENV=development
APP_VERSION=dev

# Structured application logs consumed by loggy-agent
LOG_FILE=./logs/app.jsonl
LOG_MAX_BYTES=104857600
LOG_MAX_FILES=5

# CORS: comma-separated extra origins (merged with dev defaults when NODE_ENV is not production).
# In production, this list is used alone (or defaults if empty). Dev uses permissive CORS (reflect Origin).
# CORS_ORIGIN=https://ulnk.lat

# Frontend URL used for 404 redirects from short links
# FRONTEND_BASE_URL=http://localhost:8080
