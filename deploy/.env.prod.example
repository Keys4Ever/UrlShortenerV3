DB_NAME=url_shortener
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Use a long random secret (openssl rand -hex 32)
JWT_SECRET=change_me

# Public URLs
SHORT_URL_BASE=https://example.com
FRONTEND_BASE_URL=https://www.example.com
VITE_API_BASE_URL=https://www.example.com

# CORS
CORS_ORIGIN=https://www.example.com,https://example.com

# TypeORM: keep false in stable production.
# For first bootstrap only, set TYPEORM_SYNCHRONIZE=true, start backend once, then set back to false.
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# Structured logs read by loggy-agent
LOG_MAX_BYTES=104857600
LOG_MAX_FILES=5
